{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Django",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py"
        },
        {
            "name": "Python Debugger: Django-linux",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Python Debugger: Django-linux global",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "0.0.0.0:8000"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
    "name": "Python Debugger: Django-linux global SSL",
    "type": "debugpy",
    "request": "launch",
    "args": [
        "runserver_plus",
        "--cert-file",
        "/home/mohamed/192.168.2.5+1.pem",
        "--key-file",
        "/home/mohamed/192.168.2.5+1-key.pem",
        "0.0.0.0:8000"
    ],
    "django": true,
    "autoStartBrowser": false,
    "program": "${workspaceFolder}/manage.py",
    "justMyCode": true,
    "env": {
        "PYTHONUNBUFFERED": "1"
    }
},
        {
            "name": "Python Debugger: Test",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                "--failfast",
                "-v",
                "2"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py"
        }
    ]
}